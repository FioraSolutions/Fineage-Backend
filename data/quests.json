      "dialogs": [
        {
          "npcId": 30370,
          "hook": "talk",
          "when": "absent",
          "races": [
            1
          ],
          "minLevel": 3,
          "html": "<html><body>Nerupa:<br>My sisters gathered Silvery Spidersilk for a trader in the village, but I will not walk among those walls. Will you carry it for me?<br><a action=\"quest_event:160:accept\">I will deliver it.</a></body></html>"
        },
        {
          "npcId": 30370,
          "hook": "talk",
          "when": "absent",
          "races": [
            1
          ],
          "html": "<html><body>Nerupa:<br>I have an errand for a child of the forest, but you are still too young. Come back at level 3.</body></html>"
        },
        {
          "npcId": 30370,
          "hook": "talk",
          "when": "absent",
          "html": "<html><body>Nerupa:<br>The forest watches you, stranger. My errands are for Elves only.</body></html>"
