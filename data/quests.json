          "npcId": 30362,
          "hook": "talk",
          "when": "completed",
          "html": "<html><body>Andellia:<br>Thanks to you we made this year's nectar.</body></html>"
        },
        {
          "npcId": 30371,
          "hook": "talk",
          "when": "started",
          "cond": 1,
          "html": "<html><body>Thalia:<br>Andellia sent you. This is the only fruit we harvested this year. Take it to her safely.<br><a action=\"quest_event:161:lake\">Ask about Lake Iris</a></body></html>",
          "ops": [
            {
              "op": "take_item",
              "itemId": 1036,
              "count": 1
            },
            {
              "op": "give_item",
              "itemId": 1037,
              "count": 1
            },
            {
              "op": "set_cond",
              "cond": 2
            }
          ]
        },
        {
          "npcId": 30371,
          "hook": "talk",
          "when": "started",
          "cond": 2,
          "html": "<html><body>Thalia:<br>Still here? Andellia needs the fruit before it spoils.<br><a action=\"quest_event:161:lake\">Ask about Lake Iris</a></body></html>"
        },
        {
          "npcId": 30371,
          "hook": "event",
          "event": "lake",
