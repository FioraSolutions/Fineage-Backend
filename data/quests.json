    {
      "id": 161,
      "name": "Fruit of the Mother Tree",
      "repeatable": false,
      "abortable": true,
      "questItems": [
        1036,
        1037
      ],
      "dialogs": [
        {
          "npcId": 30362,
          "hook": "talk",
          "when": "absent",
          "races": [
            1
          ],
          "minLevel": 3,
          "html": "<html><body>Andellia:<br>The Mother Tree fruit harvest grows smaller every year. My sister Thalia keeps this year's fruit at Lake Iris. Will you fetch it?<br><a action=\"quest_event:161:accept\">I will go to Thalia.</a></body></html>"
        },
        {
          "npcId": 30362,
          "hook": "talk",
          "when": "absent",
          "races": [
            1
          ],
          "html": "<html><body>Andellia:<br>I need help with the Mother Tree fruit, but the road to Lake Iris is not for the very young. Come back at level 3.</body></html>"
        },
        {
          "npcId": 30362,
          "hook": "talk",
          "when": "absent",
          "html": "<html><body>Andellia:<br>Welcome, guest. Rest under the Mother Tree. I do not ask favors of guests; this errand is for Elves.</body></html>"
        },
        {
          "npcId": 30362,
          "hook": "event",
          "event": "accept",
          "when": "absent",
          "races": [
            1
          ],
          "minLevel": 3,
          "html": "<html><body>Andellia:<br>Take my letter to Thalia. Follow the southern path to Lake Iris; she lives in the observatory on the eastern shore. Hurry before the fruit spoils.</body></html>",
          "ops": [
            {
              "op": "create"
            },
            {
              "op": "start"
            },
            {
              "op": "give_item",
              "itemId": 1036,
              "count": 1
            }
          ]
        },
        {
          "npcId": 30362,
          "hook": "talk",
          "when": "started",
          "cond": 1,
          "html": "<html><body>Andellia:<br>Thalia is at Lake Iris, south of the village. Please bring the fruit back quickly.</body></html>"
        },
        {
          "npcId": 30362,
          "hook": "talk",
          "when": "started",
          "cond": 2,
          "html": "<html><body>Andellia:<br>The fruit is still fresh. Thank you, for all the children of the forest.</body></html>",
          "ops": [
            {
              "op": "take_item",
              "itemId": 1037,
              "count": 1
            },
            {
              "op": "give_adena",
              "count": 1000
            },
