# Shared by fineage-login and fineage-zone. Copy to /etc/fineage.env.
# Login and Zone must use the same FINEAGE_HANDOFF_SECRET.
FINEAGE_BIND=0.0.0.0
FINEAGE_LOGIN_PORT=9106
FINEAGE_LOGIN_HTTP_PORT=5080
FINEAGE_ZONE_PORT=9777
# Address a remote V2 client should dial for the zone. Not the bind address.
FINEAGE_ZONE_HOST=192.168.1.13
FINEAGE_LOGIN_STORE=/var/lib/fineage/accounts.json
FINEAGE_HANDOFF_SECRET=replace-with-a-long-random-string
