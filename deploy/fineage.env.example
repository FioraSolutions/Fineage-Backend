# Shared by fineage-login and fineage-zone. Copy to /etc/fineage.env.
# Login and Zone must use the same FINEAGE_HANDOFF_SECRET.
FINEAGE_BIND=0.0.0.0
FINEAGE_LOGIN_PORT=9106
FINEAGE_LOGIN_HTTP_PORT=5080
FINEAGE_ZONE_PORT=9777
# Address a remote V2 client should dial for the zone. Not the bind address.
FINEAGE_ZONE_HOST=192.168.1.13
FINEAGE_LOGIN_STORE=/var/lib/fineage/accounts.json
FINEAGE_HANDOFF_SECRET=replace-with-a-long-random-string
# Handoff token lifetime in seconds (default 600).
# FINEAGE_HANDOFF_TTL_SECONDS=600
# Optional zone TCP tuning (defaults shown).
# FINEAGE_ZONE_MAX_CONNECTIONS=2048
# FINEAGE_ZONE_OUTBOUND_QUEUE=32
# FINEAGE_ZONE_MAX_MSG_PER_SEC=120
# FINEAGE_LOGIN_MAX_CONNECTIONS=2048
# FINEAGE_LOGIN_OUTBOUND_QUEUE=32
# FINEAGE_LOGIN_MAX_MSG_PER_SEC=120
# FINEAGE_TCP_IDLE_SECONDS=120
# FINEAGE_ZONE_INTEREST_RANGE=0
# Zone GiveItem (opcode 17). Off when unset. 1, true, or yes enables it for smoke tests.
# FINEAGE_ZONE_ADMIN=0

# Character create is permanent for the Fineage playtest: races 0–4 and base classes
# 0, 10, 18, 25, 31, 38, 44, 49, 53 (Dwarf has no mystic). Leave both unset.
# The old Human-only values FINEAGE_ALLOWED_RACES=0 and FINEAGE_ALLOWED_CLASSES=0,10
# are ignored so a stuck MVP flag cannot block Elf, Dark Elf, Orc, or Dwarf.
# Any other comma-separated id list still restricts creation.
# FINEAGE_ALLOWED_RACES=
# FINEAGE_ALLOWED_CLASSES=

# Structured logs. Default level Information, format key=value (one line).
# FINEAGE_LOG_LEVEL=Information
# FINEAGE_LOG_FORMAT=kv
# json is the other format. Passwords, tokens, and session keys are never written.

# Console summary interval in seconds. Default 60. 0 or off disables the line.
# FINEAGE_METRICS_SUMMARY_SECONDS=60
# Optional Prometheus text on GET /metrics. Disabled when unset or 0.
# Login and Zone are separate processes; give them different ports.
# FINEAGE_METRICS_BIND=127.0.0.1
# FINEAGE_LOGIN_METRICS_PORT=9464
# FINEAGE_ZONE_METRICS_PORT=9465
# FINEAGE_METRICS_PORT is the fallback when the role-specific port above is unset.

# OpenTelemetry (optional). Login and Zone each expose meter Fineage.Server and
# activity source Fineage.Server. TCP metrics carry tag endpoint=login or endpoint=zone.
# Export with the OpenTelemetry .NET SDK (not wired in-process yet); typical env:
#   OTEL_SERVICE_NAME=fineage-login
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Instruments (all on meter Fineage.Server):
#   fineage.connections              — open TCP sessions (UpDownCounter)
#   fineage.connections.rejected     — accept dropped at connection cap
#   fineage.frames.in / .out         — packets in / out
#   fineage.bytes.in / .out          — packet bytes in / out
#   fineage.packets.per_second       — packets/s, tag direction=in|out
#   fineage.handler.ms               — packet handler duration
#   fineage.packets.rejected         — rate limit, unknown opcode, wrong port
#   fineage.packets.errored          — error response or handler failure
#   fineage.outbound.dropped         — outbound queue full (TrySend)
#   fineage.tick.ms                  — zone simulation tick duration (zone only)
#   fineage.zone.online              — players in zone simulation (zone only)
# FINEAGE_ZONE_TICK_MS=3000
