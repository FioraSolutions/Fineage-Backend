<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Fineage.Protocol</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <Description>Fineage protocol constants and message DTOs. The Net PacketEnvelope codec owns the wire; Interlude Blowfish is a compatibility primitive.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="Interlude/BlowfishEngine.cs">
      <Nullable>disable</Nullable>
    </Compile>
  </ItemGroup>
</Project>
